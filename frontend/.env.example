# LinkPulse Environment Configuration
# Set to 'false' in production when real microservices are connected
NEXT_PUBLIC_USE_MOCK_API=true

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Central API Gateway / BFF
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000/api/v1

# Independent Microservices Endpoints (optional overrides)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001/api/v1/auth
NEXT_PUBLIC_LINK_SERVICE_URL=http://localhost:8002/api/v1/links
NEXT_PUBLIC_REDIRECT_SERVICE_URL=http://localhost:8003/api/v1/redirect
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8004/api/v1/analytics
NEXT_PUBLIC_WORKSPACE_SERVICE_URL=http://localhost:8005/api/v1/workspaces
NEXT_PUBLIC_DOMAIN_SERVICE_URL=http://localhost:8006/api/v1/domains
NEXT_PUBLIC_BILLING_SERVICE_URL=http://localhost:8007/api/v1/billing
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:8008/api/v1/notifications
