{
  "name": "linkpulse-url-shortener-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npx concurrently -k -n \"frontend,backend\" -c \"cyan,magenta\" \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "db:sync": "npm --prefix backend run db:sync",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:deploy": "npm --prefix backend run db:migrate:deploy",
    "db:migrate:status": "npm --prefix backend run db:migrate:status",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint"
  }
}
