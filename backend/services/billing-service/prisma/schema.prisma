generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscription {
  id                      String   @id @default(uuid())
  workspaceId             String   @unique
  planId                  String   @default("pro")
  planName                String   @default("Pro Growth Plan")
  status                  String   @default("active") // active, trialing, past_due, canceled
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeCheckoutSessionId String?
  monthlyClicksLimit      Int      @default(50000)
  usedClicksCurrentPeriod Int      @default(14230)
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([workspaceId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id          String   @id @default(uuid())
  workspaceId String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("paid")
  invoiceUrl          String?
  stripeInvoiceId     String? @unique
  stripePaymentIntentId String?
  hostedInvoiceUrl    String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  stripeEventId String @unique
  type        String
  processedAt DateTime @default(now())
}