{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@linkpulse/common": ["packages/common/src"],
      "@linkpulse/events": ["packages/events/src"],
      "@linkpulse/logger": ["packages/logger/src"]
    }
  }
}
