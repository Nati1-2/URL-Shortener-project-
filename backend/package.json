{
  "name": "linkpulse-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:gateway": "ts-node services/api-gateway/src/index.ts",
    "dev:auth": "ts-node services/auth-service/src/index.ts",
    "dev:link": "ts-node services/link-service/src/index.ts",
    "dev:redirect": "ts-node services/redirect-service/src/index.ts",
    "dev:analytics": "ts-node services/analytics-service/src/index.ts",
    "dev:workspace": "ts-node services/workspace-service/src/index.ts",
    "dev:domain": "ts-node services/domain-service/src/index.ts",
    "dev:billing": "ts-node services/billing-service/src/index.ts",
    "dev:notification": "ts-node services/notification-service/src/index.ts",
    "seed": "ts-node scripts/seed.ts",
    "db:sync": "ts-node scripts/db-sync.ts",
    "db:migrate": "ts-node scripts/migrate.ts dev",
    "db:migrate:deploy": "ts-node scripts/migrate.ts deploy",
    "db:migrate:status": "ts-node scripts/migrate.ts status",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:all": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=services/auth-service/prisma/schema.prisma && prisma generate --schema=services/link-service/prisma/schema.prisma && prisma generate --schema=services/analytics-service/prisma/schema.prisma && prisma generate --schema=services/workspace-service/prisma/schema.prisma && prisma generate --schema=services/domain-service/prisma/schema.prisma && prisma generate --schema=services/billing-service/prisma/schema.prisma && prisma generate --schema=services/notification-service/prisma/schema.prisma",
    "dev:all": "ts-node src/server.ts",
    "start": "ts-node src/server.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@upstash/redis": "^1.38.2",
    "amqplib": "^0.10.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "stripe": "^17.7.0",
    "ua-parser-js": "^1.0.40",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.13.4",
    "@types/stripe": "^8.0.417",
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
