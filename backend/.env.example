# ==============================================================================
# LinkPulse Backend Microservices Environment Template
# Copy this file to `backend/.env`
# NEVER commit real passwords or private keys to version control!
# ==============================================================================

# PostgreSQL Database (Neon Serverless, RDS, or Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkpulse?sslmode=disable

# Redis Cache & Pub/Sub (Upstash Redis or Local Redis)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# RabbitMQ AMQP Message Broker (CloudAMQP or Local RabbitMQ)
RABBITMQ_URL=amqp://localhost:5672

# Environment & Server Ports
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:3000

# Cryptographic JWT Authentication Secrets (Generate secure random strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# Stripe Payment & Subscription Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly_price
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_your_enterprise_monthly_price
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_your_enterprise_yearly_price

# Custom Domain Verification DNS Target
CNAME_TARGET=cname.linkpulse.io
