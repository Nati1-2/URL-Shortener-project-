# ==============================================================================
# LinkPulse Full-Stack Environment Template
# Copy this file to backend/.env and frontend/.env.local respectively.
# NEVER commit real credentials, passwords, or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# Multi-schema or multi-database PostgreSQL connection string (e.g. Neon, AWS RDS, Local)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkpulse?sslmode=disable

# ------------------------------------------------------------------------------
# 2. Redis Cache & Event Fallback Configuration
# Redis connection URL (e.g. Upstash TLS or Local Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Message Broker (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://localhost:5672

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security
# Generate secure 64-character random strings for production
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production

# ------------------------------------------------------------------------------
# 5. Core Application URLs & Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Stripe Payment & Billing Configuration
# Get API keys from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 7. Custom Domain CNAME Routing
# ------------------------------------------------------------------------------
CNAME_TARGET=cname.linkpulse.io

# ------------------------------------------------------------------------------
# 8. Frontend Public Environment Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK_API=false
